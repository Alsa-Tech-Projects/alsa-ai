{
  "name": "alsa-ai-desktop",
  "productName": "Alsa AI",
  "description": "Alsa AI - Intelligent Neural Workspace & PC Controller Desktop Application",
  "author": "Alsa AI Team",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node electron/copy-assets.cjs && concurrently -k -r \"vite\" \"tsc -p tsconfig.node.json --watch\"",
    "dev:desktop": "node electron/copy-assets.cjs && concurrently -k -r \"cross-env BROWSER=none vite\" \"tsc -p tsconfig.node.json --watch\" \"cross-env NODE_ENV=development electron .\"",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "build:web": "vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "postbuild:electron": "node electron/copy-assets.cjs",
    "build": "vite build && tsc -p tsconfig.node.json && electron-builder",
    "build:dev": "vite build --mode development",
    "build:dir": "vite build && tsc -p tsconfig.node.json && electron-builder --dir",
    "lint": "eslint .",
    "preview": "vite preview"
  },
